#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Commit message validation
# Follows Conventional Commits: https://www.conventionalcommits.org/

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Conventional commit pattern
# type(scope): description
# Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?: .{1,100}$"

# Check if it's a merge commit or fixup
if echo "$commit_msg" | grep -qE "^(Merge|fixup!|squash!)"; then
    exit 0
fi

# Validate commit message
if ! echo "$commit_msg" | head -1 | grep -qE "$pattern"; then
    echo ""
    echo "❌ Invalid commit message format!"
    echo ""
    echo "📝 Expected format: <type>(<scope>): <description>"
    echo ""
    echo "Types:"
    echo "  feat     - A new feature"
    echo "  fix      - A bug fix"
    echo "  docs     - Documentation only changes"
    echo "  style    - Code style changes (formatting, semicolons, etc)"
    echo "  refactor - Code refactoring (no feature or bug fix)"
    echo "  perf     - Performance improvements"
    echo "  test     - Adding or updating tests"
    echo "  build    - Build system or dependencies"
    echo "  ci       - CI/CD configuration"
    echo "  chore    - Other changes (maintenance)"
    echo "  revert   - Revert a previous commit"
    echo ""
    echo "Examples:"
    echo "  feat(ui): add new Button component"
    echo "  fix(shell): resolve routing issue"
    echo "  docs: update CI/CD documentation"
    echo "  chore(deps): update dependencies"
    echo ""
    echo "Your message: $commit_msg"
    echo ""
    exit 1
fi

echo "✅ Commit message is valid!"
