# ============================================
# Orbit MFE Platform - Environment Configuration
# ============================================
# Copy this file to .env and adjust values as needed
# Run: cp .env.example .env

# --------------------------------------------
# Port Configuration
# --------------------------------------------
# Each MFE runs on its own port during development
# These must match the ports defined in packages/config/src/env/ports.ts

SHELL_PORT=8000
APP_REACT_PORT=8001
APP_NEXTJS_PORT=8002
APP_VUE_PORT=8003
APP_SVELTE_PORT=8004
APP_SOLIDJS_PORT=8005

# --------------------------------------------
# Vite Configuration
# --------------------------------------------
# Suppress Vite CJS deprecation warning from Remix 2.x
# See: https://github.com/remix-run/remix/discussions/7632
VITE_CJS_IGNORE_WARNING=true

# --------------------------------------------
# MFE Mode Configuration
# --------------------------------------------
# VITE_STANDALONE: Run MFE independently (not loaded by shell)
# - "true": App mounts itself to #root or #app element
# - "false" or unset: App is loaded by shell via Module Federation
VITE_STANDALONE=false

# --------------------------------------------
# Loading Strategy (Shell only)
# --------------------------------------------
# MFE_LOADING_MODE: How shell loads MFE bundles
# - "federation": Use Module Federation (dev mode - HMR enabled)
# - "manifest": Use manifest.json loading (prod mode - cached)
# Default: federation in dev, manifest in prod
# MFE_LOADING_MODE=federation

# --------------------------------------------
# API Configuration (Optional)
# --------------------------------------------
# VITE_API_URL=http://localhost:3001/api
# VITE_AUTH_URL=http://localhost:3001/auth
