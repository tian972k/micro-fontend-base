{
  "name": "orbit",
  "author": "Tuan Pham <phamtuandev0907@gmail.com>",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "dev": "node scripts/build-all-mfes.mjs && node scripts/generate-dev-manifest.mjs && turbo run dev",
    "build:all-mfes": "node scripts/build-all-mfes.mjs",
    "dev:shell": "turbo run dev --filter=shell",
    "dev:mfes": "node scripts/generate-dev-manifest.mjs && node scripts/build-all-mfes.mjs && turbo run dev $(node scripts/get-mfe-filters.mjs)",
    "dev:all": "node scripts/generate-dev-manifest.mjs && node scripts/build-all-mfes.mjs && turbo run dev $(node scripts/get-mfe-filters.mjs) --filter=shell",
    "dev:standalone:react": "VITE_STANDALONE=true turbo run dev --filter=app-react",
    "dev:standalone:nextjs": "VITE_STANDALONE=true turbo run dev --filter=app-nextjs",
    "dev:standalone:vue": "VITE_STANDALONE=true turbo run dev --filter=app-vue",
    "dev:standalone:svelte": "VITE_STANDALONE=true turbo run dev --filter=app-svelte",
    "dev:standalone:solidjs": "VITE_STANDALONE=true turbo run dev --filter=app-solidjs",
    "lint": "turbo run lint",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules\" \"!**/node_modules\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"!node_modules\" \"!**/node_modules\"",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install",
    "clean": "turbo run clean && rm -rf node_modules",
    "storybook": "pnpm --filter @repo/ui storybook",
    "cli": "node scripts/cli.mjs",
    "create-app": "node scripts/create-app.mjs",
    "generate-ui": "node scripts/generate-ui.mjs",
    "validate:app-ids": "node scripts/validate-app-ids.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^8.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "markdownlint-cli2": "^0.20.0",
    "prettier": "^3.0.0",
    "turbo": "latest",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18"
  }
}
