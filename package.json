{
  "name": "orbit",
  "author": "Tuan Pham <phamtuandev0907@gmail.com>",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:apps": "turbo run build --filter='./apps/*'",
    "build:mfes:prod": "node scripts/build-all-mfes-prod.mjs",
    "start": "turbo run start",
    "kill-ports": "node scripts/kill-ports.mjs",
    "dev": "node scripts/kill-ports.mjs && node scripts/generate-dev-manifest.mjs && turbo run dev",
    "dev:shell": "turbo run dev --filter=shell",
    "dev:all": "node scripts/kill-ports.mjs && node scripts/generate-dev-manifest.mjs && turbo run dev",
    "lint": "turbo run lint",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules\" \"!**/node_modules\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"!node_modules\" \"!**/node_modules\"",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "size": "node scripts/bundle-report.mjs",
    "analyze": "ANALYZE=true turbo run build --force --filter='./apps/*'",
    "deps:unused": "node scripts/check-unused-deps.mjs",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,json,css}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:cache": "rm -rf node_modules/.cache .turbo apps/*/.turbo packages/*/.turbo apps/*/.vite packages/*/.vite",
    "clean:turbo": "turbo daemon clean && rm -rf .turbo",
    "clean:all": "pnpm clean:cache && pnpm clean",
    "prepare": "husky install",
    "storybook": "pnpm --filter @repo/ui storybook",
    "mfe:add": "node scripts/add-mfe.mjs",
    "orbit:init": "node scripts/orbit-init.mjs",
    "g": "node scripts/generate.mjs",
    "generate": "node scripts/generate.mjs",
    "validate:mfe-config": "node scripts/mfe.config.mjs",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ],
    "*.{mjs,cjs,mts,vue,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@lhci/cli": "~0.15.1",
    "@playwright/test": "~1.56.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "catalog:",
    "eslint-plugin-storybook": "^10.6.7",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "markdownlint-cli2": "^0.20.0",
    "prettier": "^3.10.1",
    "turbo": "2.7.5",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.33",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "react-router-dom@>=6.0.0 <6.30.6": "^6.30.6",
      "react-router@>=6.0.0 <6.30.6": "^6.30.6"
    }
  }
}
