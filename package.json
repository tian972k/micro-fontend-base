{
  "name": "orbit",
  "author": "Tuan Pham <phamtuandev0907@gmail.com>",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:apps": "turbo run build --filter='./apps/*'",
    "build:mfes": "node scripts/build-all-mfes.mjs",
    "build:mfes:prod": "node scripts/build-all-mfes-prod.mjs",
    "start": "turbo run start",
    "dev": "node scripts/generate-dev-manifest.mjs && turbo run dev",
    "dev:shell": "turbo run dev --filter=shell",
    "dev:mfes": "node scripts/generate-dev-manifest.mjs && turbo run dev $(node scripts/get-mfe-filters.mjs)",
    "dev:all": "node scripts/generate-dev-manifest.mjs && turbo run dev",
    "lint": "turbo run lint",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules\" \"!**/node_modules\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"!node_modules\" \"!**/node_modules\"",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,json,css}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky install",
    "storybook": "pnpm --filter @repo/ui storybook",
    "cli": "node scripts/cli.mjs",
    "create-app": "node scripts/create-app.mjs",
    "generate-ui": "node scripts/generate-ui.mjs",
    "validate:app-ids": "node scripts/validate-app-ids.mjs",
    "validate:mfe-config": "node scripts/mfe.config.mjs",
    "docker:build": "docker-compose build",
    "docker:build:smart": "node scripts/smart-docker-build.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^8.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "markdownlint-cli2": "^0.20.0",
    "prettier": "^3.0.0",
    "turbo": "latest",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18"
  }
}
