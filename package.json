{
  "name": "orbit",
  "author": "Tuan Pham <phamtuandev0907@gmail.com>",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:apps": "turbo run build --filter='./apps/*'",
    "build:mfes:prod": "node scripts/build-all-mfes-prod.mjs",
    "start": "turbo run start",
    "kill-ports": "node scripts/kill-ports.mjs",
    "dev": "node scripts/kill-ports.mjs && node scripts/generate-dev-manifest.mjs && turbo run dev",
    "dev:shell": "turbo run dev --filter=shell",
    "dev:all": "node scripts/kill-ports.mjs && node scripts/generate-dev-manifest.mjs && turbo run dev",
    "lint": "turbo run lint",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules\" \"!**/node_modules\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"!node_modules\" \"!**/node_modules\"",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,json,css}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:cache": "rm -rf node_modules/.cache .turbo apps/*/.turbo packages/*/.turbo apps/*/.vite packages/*/.vite",
    "clean:turbo": "turbo daemon clean && rm -rf .turbo",
    "clean:all": "pnpm clean:cache && pnpm clean",
    "prepare": "husky install",
    "storybook": "pnpm --filter @repo/ui storybook",
    "mfe:add": "node scripts/add-mfe.mjs",
    "validate:mfe-config": "node scripts/mfe.config.mjs",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "~1.56.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "catalog:",
    "eslint-plugin-storybook": "^10.1.11",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "markdownlint-cli2": "^0.20.0",
    "prettier": "^3.0.0",
    "turbo": "2.7.5",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=18"
  }
}
