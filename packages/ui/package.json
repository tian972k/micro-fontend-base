{
  "name": "@repo/ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "imports": {
    "#variants/*": "./src/shared/variants/*",
    "#shared/*": "./src/shared/*",
    "#components/*": "./src/components/*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./src/react.ts",
      "development": "./src/react.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./src/vue.ts",
      "development": "./src/vue.ts",
      "import": "./dist/vue.js"
    },
    "./solid": {
      "types": "./src/solid.ts",
      "development": "./src/solid.ts",
      "import": "./dist/solid.js"
    },
    "./svelte": {
      "types": "./src/svelte.ts",
      "development": "./src/svelte.ts",
      "import": "./dist/svelte.js"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "development": "./src/shared.ts",
      "import": "./dist/shared.js"
    },
    "./globals.css": "./src/styles/globals.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint \"**/*.ts*\"",
    "clean": "rm -rf node_modules dist .turbo",
    "storybook": "storybook dev -p 6006 --config-dir .storybook",
    "storybook:react": "storybook dev -p 6006 --config-dir .storybook-react",
    "storybook:vue": "storybook dev -p 6007 --config-dir .storybook-vue",
    "storybook:solid": "storybook dev -p 6008 --config-dir .storybook-solid",
    "storybook:svelte": "storybook dev -p 6009 --config-dir .storybook-svelte",
    "storybook:all": "concurrently \"pnpm storybook:react\" \"pnpm storybook:vue\" \"pnpm storybook:solid\" \"pnpm storybook:svelte\"",
    "build-storybook": "storybook build --config-dir .storybook",
    "build-storybook:react": "storybook build --config-dir .storybook-react -o storybook-static/react",
    "build-storybook:vue": "storybook build --config-dir .storybook-vue -o storybook-static/vue",
    "build-storybook:solid": "storybook build --config-dir .storybook-solid -o storybook-static/solid",
    "build-storybook:svelte": "storybook build --config-dir .storybook-svelte -o storybook-static/svelte",
    "build-storybook:all": "pnpm build-storybook:react && pnpm build-storybook:vue && pnpm build-storybook:solid && pnpm build-storybook:svelte",
    "generate": "node cli/generate-component.js",
    "g": "node cli/generate-component.js"
  },
  "bin": {
    "ui-generate": "./cli/generate-component.js"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/utils": "workspace:*",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vue": "^3.4.0",
    "solid-js": "^1.8.0",
    "svelte": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "lucide-react": "^0.300.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-links": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@storybook/vue3-vite": "^10.1.11",
    "@storybook/svelte-vite": "^10.1.11",
    "storybook-solidjs": "^1.0.0-beta.7",
    "storybook-solidjs-vite": "^1.0.0-beta.7",
    "@types/lodash": "^4.17.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.0.0",
    "eslint-plugin-storybook": "^10.1.11",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "vue": "^3.4.0",
    "solid-js": "^1.8.0",
    "svelte": "^4.0.0",
    "storybook": "^10.1.11",
    "typescript": "^5.0.0",
    "vite": "^7.3.1"
  },
  "sideEffects": [
    "*.css",
    "./src/styles/**/*"
  ]
}
