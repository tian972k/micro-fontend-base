{
  "extends": "@repo/config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "#variants/*": ["./src/shared/variants/*"],
      "#shared/*": ["./src/shared/*"],
      "#components/*": ["./src/components/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/components/vue/**/*",
    "src/components/svelte/**/*",
    "src/components/solid/**/*",
    "src/vue.ts",
    "src/svelte.ts",
    "src/solid.ts"
  ]
}
