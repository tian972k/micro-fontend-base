{
  "name": "app-svelte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/generate-manifest.mjs $PWD",
    "build:mfe": "MFE_MODE=true vite build && node ../../scripts/generate-manifest.mjs $PWD",
    "build:standalone": "vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf node_modules dist .cache .turbo .vite",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "catalog:",
    "autoprefixer": "catalog:",
    "svelte-check": "^3.8.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
