{
  "name": "app-svelte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/generate-manifest.mjs $PWD",
    "build:mfe": "MFE_MODE=true vite build && node ../../scripts/generate-manifest.mjs $PWD",
    "build:standalone": "vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf node_modules dist .cache .turbo .vite",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "dayjs": "catalog:",
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "catalog:",
    "i18next-http-backend": "catalog:",
    "lodash": "catalog:",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.2",
    "@tsconfig/svelte": "^5.0.2",
    "@types/node": "catalog:",
    "svelte-check": "^3.6.7",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
