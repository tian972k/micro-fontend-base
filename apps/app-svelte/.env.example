# ============================================
# app-svelte - Environment Configuration
# ============================================
# Copy this file to .env: cp .env.example .env
# For production testing: Vite auto-loads .env.production when NODE_ENV=production

# ============================================
# Development
# ============================================
# Local dev server port
VITE_APP_PORT=8004

# ============================================
# Production / Vercel
# ============================================
# Base path when deployed under gateway (via rewrites)
# Leave empty for standalone deployment
# Examples: "/svelte/" for gateway proxy, "/" for standalone domain
VITE_PUBLIC_BASE_PATH=/svelte/

# API Gateway base URL (if fetching from shell or cross-app communication)
# VITE_PUBLIC_GATEWAY_URL=https://example.com
# VITE_PUBLIC_GATEWAY_URL=http://localhost:8000

# ============================================
# CORS & Security (Production)
# ============================================
# Update CORS origin in vercel.json manually or set via CI/CD
# VERCEL_CORS_ORIGIN=https://example.com

# ============================================
# Feature Flags (Optional)
# ============================================
# VITE_PUBLIC_ENABLE_DEBUG_MODE=false
# VITE_PUBLIC_ENABLE_ANALYTICS=false
