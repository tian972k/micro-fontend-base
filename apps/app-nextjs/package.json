{
  "name": "app-nextjs",
  "mfe": {
    "outputDir": "public"
  },
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev -p 8002",
    "dev:with-mfe": "pnpm build:mfe && pnpm watch:mfe & pnpm dev",
    "build": "pnpm build:mfe && next build",
    "start": "next start -p 8002",
    "lint": "next lint",
    "build:mfe": "vite build -c vite.config.mts && node ../../scripts/generate-manifest.mjs $PWD public",
    "watch:mfe": "vite build -c vite.config.mts --watch",
    "clean": "rm -rf node_modules .next out dist .cache .turbo",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "dayjs": "catalog:",
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "catalog:",
    "i18next-http-backend": "catalog:",
    "lodash": "catalog:",
    "next": "^14.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "catalog:",
    "@repo/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
