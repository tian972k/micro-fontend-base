# ============================================
# app-nextjs - Environment Configuration
# ============================================
# Copy this file to .env.local: cp .env.example .env.local
# For production testing: Vite auto-loads .env.production when NODE_ENV=production

# ============================================
# Development
# ============================================
# Local dev server port
VITE_APP_PORT=8002

# ============================================
# Production / Vercel
# ============================================
# Base path when deployed under gateway (via rewrites)
# Leave empty for standalone deployment
# Examples: "/next/" for gateway proxy, "/" for standalone domain
NEXT_PUBLIC_BASE_PATH=/next/

# API Gateway base URL (if fetching from shell or cross-app communication)
# NEXT_PUBLIC_GATEWAY_URL=https://example.com
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000

# ============================================
# CORS & Security (Production)
# ============================================
# Update CORS origin in vercel.json manually or set via CI/CD
# VERCEL_CORS_ORIGIN=https://example.com

# ============================================
# Feature Flags (Optional)
# ============================================
# NEXT_PUBLIC_ENABLE_DEBUG_MODE=false
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
