    "i18next-http-backend": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "catalog:",
    "@repo/config": "workspace:*",
    "@types/node": "catalog:",
    "autoprefixer": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "^2.8.2"
  }
