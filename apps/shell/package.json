{
    "name": "shell",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "build": "remix vite:build",
        "dev": "remix vite:dev --port 8000",
        "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
        "start": "remix-serve ./build/server/index.js",
        "typecheck": "tsc",
        "clean": "rm -rf node_modules build public/build .cache .turbo"
    },
    "dependencies": {
        "@remix-run/node": "^2.8.0",
        "@remix-run/react": "^2.8.0",
        "@remix-run/serve": "^2.8.0",
        "@repo/ui": "workspace:*",
        "@repo/utils": "workspace:*",
        "@repo/core": "workspace:*",
        "isbot": "^4.1.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "clsx": "^2.0.0",
        "tailwind-merge": "^2.0.0"
    },
    "devDependencies": {
        "@remix-run/dev": "^2.8.0",
        "@types/react": "^18.2.20",
        "@types/react-dom": "^18.2.7",
        "@repo/config": "workspace:*",
        "typescript": "^5.0.0",
        "vite": "^5.0.0",
        "vite-tsconfig-paths": "^4.2.1",
        "tailwindcss": "^3.3.0",
        "autoprefixer": "^10.0.0"
    }
}