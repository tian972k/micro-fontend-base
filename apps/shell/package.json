{
  "name": "shell",
  "version": "0.1.0",
  "mfe": {
    "dockerfile": "apps/shell/Dockerfile"
  },
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "remix vite:build",
    "dev": "VITE_CJS_IGNORE_WARNING=true remix vite:dev --port 8000",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "PORT=${PORT:-8000} remix-serve ./build/server/index.js",
    "start:local": "MFE_FORCE_LOCALHOST=true PORT=${PORT:-8000} remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "clean": "rm -rf node_modules build public/build .cache .turbo"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@remix-run/node": "^2.17.4",
    "@remix-run/react": "^2.17.4",
    "@remix-run/serve": "^2.17.4",
    "@repo/config": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "accept-language-parser": "^1.5.0",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.19",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "isbot": "^4.1.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.3",
    "remix-custom-routes": "^1.0.1",
    "remix-i18next": "^6.4.1",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@remix-run/dev": "^2.17.4",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "autoprefixer": "^10.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-tsconfig-paths": "^4.2.1"
  }
}
