# ============================================
# Shell Application - Environment Configuration
# ============================================
# Copy this file to .env: cp .env.example .env

# ============================================
# Development - Port Configuration
# ============================================
SHELL_PORT=8000
APP_REACT_PORT=8001
APP_NEXTJS_PORT=8002
APP_VUE_PORT=8003
APP_SVELTE_PORT=8004
APP_SOLIDJS_PORT=8005

# ============================================
# Vite Configuration
# ============================================
VITE_CJS_IGNORE_WARNING=true

# ============================================
# MFE Loading Strategy
# ============================================
# MFE_LOADING_MODE: How to load MFE bundles
# - "federation": Module Federation (dev - HMR enabled)
# - "manifest": Manifest-based loading (prod - cached)
# MFE_LOADING_MODE=federation

# ============================================
# Production / Vercel
# ============================================
# Gateway domain (used in dynamic routing or verification)
# VITE_GATEWAY_DOMAIN=https://example.com

# MFE hosts for dynamic routing (if not using vercel.json rewrites)
# VITE_APP_REACT_HOST=https://app-react.vercel.app
# VITE_APP_NEXTJS_HOST=https://app-nextjs.vercel.app
# VITE_APP_VUE_HOST=https://app-vue.vercel.app
# VITE_APP_SVELTE_HOST=https://app-svelte.vercel.app
# VITE_APP_SOLIDJS_HOST=https://app-solidjs.vercel.app

# ============================================
# Feature Flags (Optional)
# ============================================
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG_MODE=false
