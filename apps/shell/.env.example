# ============================================
# Shell Application - Environment Configuration
# ============================================
# Copy this file to .env: cp .env.example .env
# For production: use .env.production (auto-loaded when NODE_ENV=production)

# ============================================
# Development - Port Configuration
# ============================================
SHELL_PORT=8000
APP_REACT_PORT=8001
APP_NEXTJS_PORT=8002
APP_VUE_PORT=8003
APP_SVELTE_PORT=8004
APP_SOLIDJS_PORT=8005

# ============================================
# Vite Configuration
# ============================================
VITE_CJS_IGNORE_WARNING=true

# ============================================
# MFE Loading Strategy (Development)
# ============================================
# MFE_LOADING_MODE: How to load MFE bundles
# - "federation": Module Federation (dev - HMR enabled)
# - "manifest": Manifest-based loading (prod - cached)
# MFE_LOADING_MODE=federation

# ============================================
# Production / Vercel Configuration
# ============================================
# IMPORTANT: Use .env.production file instead for production settings
# These are kept here for reference only

# Deployment target flag
# Automatically set by Vercel; use for local production testing
# VERCEL=1

# Gateway domain (used in production)
# VITE_GATEWAY_DOMAIN=https://micro-fontend-base-shell.vercel.app

# MFE loading strategy for production
# MFE_LOADING_MODE=manifest

# ============================================
# Feature Flags (Optional)
# ============================================
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG_MODE=false

# ============================================
# Deployment Target
# ============================================
# Vercel automatically sets VERCEL=1 when deploying
# For local testing: NODE_ENV=production pnpm build && pnpm start
# This flag enables Vercel-specific behavior (proxy paths instead of direct URLs)
VERCEL=1
